generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  plan       Plan      @default(FREE)
  status     OrgStatus @default(ACTIVE)
  approvedAt DateTime?
  approvedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  legalName           String?
  address             Json? // { street, city, country, postalCode }
  taxId               String?
  logoUrl             String?
  defaultTaxRate      Float   @default(0)
  currency            String  @default("USD")
  onboardingCompleted Boolean @default(false)

  users             UserOrganization[]
  taxRules          TaxRule[]
  expenses          Expense[]
  invoices          Invoice[]
  anomalies         ExpenseAnomaly[]
  webhooks          Webhook[]
  reportSchedules   ReportSchedule[]
  transactions      Transaction[]
  contracts         Contract[]
  roles             Role[]
  financialSnapshot FinancialSnapshot?
  financialSettings FinancialSettings?
  notifications     Notification[]

  // P2P Models
  vendors          Vendor[]
  purchaseOrders   PurchaseOrder[]
  vendorInvoices   VendorInvoice[]
  p2pSettings      P2PSettings?
  approvalRequests ApprovalRequest[]

  // O2C Models
  customers   Customer[]
  salesOrders SalesOrder[]
  o2cSettings O2CSettings?

  dashboardLayouts DashboardLayout[]
  aiUsageLogs      AIUsageLog[]
  chatMessages     ChatMessage[]

  // GL Models
  glEntries         GeneralLedgerEntry[]
  chartOfAccounts   ChartOfAccounts[]
  journalEntries    JournalEntry[]
  accountingPeriods AccountingPeriod[]

  // Payment Models
  payments         Payment[]
  creditNotes      CreditNote[]
  vendorPayments   VendorPayment[]
  vendorDebitMemos VendorDebitMemo[]
  bankTransactions BankTransaction[]
  bankAccounts     BankAccount[]

  // Fixed Assets
  fixedAssets           FixedAsset[]
  depreciationSchedules DepreciationSchedule[]

  // Ops Models
  goodsReceipts GoodsReceipt[]
  dunningLogs   DunningLog[]
  bankFeedSyncLogs BankFeedSyncLog[]

  // Admin Models
  license      License?
  usageMetrics UsageMetrics[]

  // Numbering
  entitySequences    EntitySequence[]
  numberingSettings  NumberingSettings?

  // Product Catalog
  products Product[]

  // RAG / Knowledge Base
  financialDocuments FinancialDocument[]

  // FX
  exchangeRates ExchangeRate[]

  // Budgets
  budgets Budget[]

  // Dimensions
  dimensions Dimension[]

  // Payment Runs
  paymentRuns PaymentRun[]

  // Vendor Portal
  vendorProfileChanges VendorProfileChange[]
}

model P2PSettings {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  autoApproveLimit        Float        @default(500)
  requireThreeWayMatch    Boolean      @default(true)
  earlyPaymentDiscount    Boolean      @default(true)
  approvalDeadlineDays    Int          @default(3)
  escalationApproverId    String?
  organization            Organization @relation(fields: [organizationId], references: [id])
}

model ApprovalRequest {
  id               String    @id @default(cuid())
  organizationId   String
  entityType       String    // "PurchaseOrder" | "Expense"
  entityId         String
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED | DELEGATED | ESCALATED | EXPIRED
  approverId       String
  approverName     String
  approverEmail    String?
  requestedBy      String
  requestedAt      DateTime  @default(now())
  decidedAt        DateTime?
  decisionNote     String?
  delegatedTo      String?
  delegatedAt      DateTime?
  escalatedAt      DateTime?
  dueDate          DateTime?
  amount           Float?
  description      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization     Organization    @relation(fields: [organizationId], references: [id])
  purchaseOrders   PurchaseOrder[]
  expenses         Expense[]

  @@index([organizationId, status])
  @@index([approverId, status])
}

model Vendor {
  id             String   @id @default(cuid())
  vendorNumber   String?
  name           String
  email          String?
  taxId          String?
  address        Json?
  paymentTerms   String?  @default("NET30")
  status         String   @default("ACTIVE")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bankAccountName   String?
  bankIban          String?
  bankBic           String?
  bankRoutingNumber String?
  bankAccountNumber String?
  bankSortCode      String?
  bankCountry       String?

  portalEnabled   Boolean  @default(false)
  portalEmail     String?
  portalInvitedAt DateTime?

  organization      Organization          @relation(fields: [organizationId], references: [id])
  purchaseOrders    PurchaseOrder[]
  invoices          VendorInvoice[]
  debitMemos        VendorDebitMemo[]
  fixedAssets       FixedAsset[]
  paymentRunItems   PaymentRunItem[]
  portalSessions    VendorPortalSession[]
  profileChanges    VendorProfileChange[]
  poAcknowledgments VendorPOAcknowledgment[]
}

model PurchaseOrder {
  id                String    @id @default(cuid())
  poNumber          String    @unique
  vendorId          String
  status            String    @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED, ORDERED, RECEIVED, CLOSED
  totalAmount       Float
  description       String?
  notes             String?
  approvedBy        String?
  approvedAt        DateTime?
  approvalRequestId String?
  organizationId    String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  vendor            Vendor                   @relation(fields: [vendorId], references: [id])
  organization      Organization             @relation(fields: [organizationId], references: [id])
  lineItems         PurchaseOrderLine[]
  vendorInvoices    VendorInvoice[]
  goodsReceipts     GoodsReceipt[]
  fixedAssets       FixedAsset[]
  approvalRequest   ApprovalRequest?         @relation(fields: [approvalRequestId], references: [id])
  poAcknowledgments VendorPOAcknowledgment[]
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  productId       String?
  description     String
  quantity        Float
  unitPrice       Float
  discount        Float         @default(0)
  taxRate         Float         @default(0)
  amount          Float
  accountCode     String?
  notes           String?
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product?      @relation("POLineProduct", fields: [productId], references: [id])
}

model VendorInvoice {
  id              String    @id @default(cuid())
  internalNumber  String?
  invoiceNumber   String
  vendorId        String
  purchaseOrderId String?
  status          String    @default("RECEIVED") // RECEIVED, MATCHED, APPROVED, PAID, DISPUTED
  amount          Float
  currencyCode    String    @default("USD")
  dueDate         DateTime
  paidDate        DateTime?
  notes           String?
  agentLogs       Json?     @default("[]")
  workflowStatus  String?
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor          Vendor              @relation(fields: [vendorId], references: [id])
  purchaseOrder   PurchaseOrder?      @relation(fields: [purchaseOrderId], references: [id])
  organization    Organization        @relation(fields: [organizationId], references: [id])
  lineItems       VendorInvoiceLine[]
  vendorPayments  VendorPayment[]
  debitMemos      VendorDebitMemo[]
  paymentRunItems PaymentRunItem[]
}

model VendorPayment {
  id              String   @id @default(cuid())
  vendorInvoiceId String
  amount          Float
  paymentDate     DateTime
  method          String   @default("bank_transfer")
  referenceNumber String?
  notes           String?
  expenseId       String?
  createdById     String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendorInvoice        VendorInvoice    @relation(fields: [vendorInvoiceId], references: [id])
  organization         Organization     @relation(fields: [organizationId], references: [id])
  expense              Expense?         @relation("VendorPaymentExpense", fields: [expenseId], references: [id])
  bankTransactions     BankTransaction[] @relation("BankTransactionVendorPayment")
  transaction          Transaction?     @relation("TransactionVendorPayment")

  @@index([vendorInvoiceId])
  @@index([organizationId, paymentDate])
}

model BankTransaction {
  id                     String    @id @default(cuid())
  date                   DateTime
  description            String
  amount                 Float
  currency               String    @default("USD")
  balance                Float?
  reference              String?
  counterparty           String?
  matchedPaymentId       String?
  matchedVendorPaymentId String?
  matchStatus            String    @default("unmatched")
  matchConfidence        Float?
  matchReason            String?
  source                 String    @default("manual")
  reconciledAt           DateTime?
  organizationId         String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  bankAccountId          String?
  externalId             String?
  merchantName           String?
  merchantCategory       String?
  pending                Boolean   @default(false)

  organization         Organization   @relation(fields: [organizationId], references: [id])
  matchedPayment       Payment?       @relation("BankTransactionPayment", fields: [matchedPaymentId], references: [id])
  matchedVendorPayment VendorPayment? @relation("BankTransactionVendorPayment", fields: [matchedVendorPaymentId], references: [id])

  @@unique([organizationId, bankAccountId, externalId])
  @@index([organizationId, date])
  @@index([organizationId, matchStatus])
  @@index([bankAccountId])
}

model VendorInvoiceLine {
  id              String        @id @default(cuid())
  productId       String?
  description     String
  quantity        Float
  unitPrice       Float
  discount        Float         @default(0)
  taxRate         Float         @default(0)
  amount          Float
  accountCode     String?
  notes           String?
  vendorInvoiceId String
  vendorInvoice   VendorInvoice @relation(fields: [vendorInvoiceId], references: [id])
  product         Product?      @relation("VendorInvoiceLineProduct", fields: [productId], references: [id])
}

model Product {
  id              String   @id @default(cuid())
  code            String
  name            String
  description     String?
  unitPrice       Float    @default(0)
  costPrice       Float?
  taxRate         Float    @default(0)
  accountCode     String?
  type            String   @default("service")
  usedInSales     Boolean  @default(true)
  usedInPurchasing Boolean @default(true)
  isActive        Boolean  @default(true)
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization         Organization         @relation(fields: [organizationId], references: [id])
  invoiceLines         InvoiceLineItem[]    @relation("InvoiceLineProduct")
  salesOrderLines      SalesOrderLine[]     @relation("SOLineProduct")
  purchaseOrderLines   PurchaseOrderLine[]  @relation("POLineProduct")
  vendorInvoiceLines   VendorInvoiceLine[]  @relation("VendorInvoiceLineProduct")

  @@unique([organizationId, code])
  @@index([organizationId])
}

model O2CSettings {
  id                 String       @id @default(cuid())
  organizationId     String       @unique
  creditLimitDefault Float        @default(5000)
  autoDunning        Boolean      @default(true)
  organization       Organization @relation(fields: [organizationId], references: [id])
}

model Customer {
  id             String   @id @default(cuid())
  customerNumber String?
  name           String
  email          String?
  phone          String?
  taxId          String?
  address        Json?
  paymentTerms   String?  @default("NET30")
  creditLimit    Float    @default(5000)
  notes          String?
  status         String   @default("ACTIVE")
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  salesOrders  SalesOrder[]
  invoices     Invoice[]
  contracts    Contract[]
}

model SalesOrder {
  id             String    @id @default(cuid())
  orderNumber    String    @unique
  customerId     String
  status         String    @default("DRAFT") // DRAFT, APPROVED, INVOICED, PAID, SHIPPED
  totalAmount    Float
  dueDate        DateTime?
  agentLogs      Json?     @default("[]")
  workflowStatus String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  customer     Customer         @relation(fields: [customerId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  invoices     Invoice[]
  lineItems    SalesOrderLine[]
  dunningLogs  DunningLog[]
}

model SalesOrderLine {
  id           String     @id @default(cuid())
  productId    String?
  description  String
  quantity     Float
  unitPrice    Float
  discount     Float      @default(0)
  taxRate      Float      @default(0)
  amount       Float
  accountCode  String?
  notes        String?
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  product      Product?   @relation("SOLineProduct", fields: [productId], references: [id])
}

model FinancialSettings {
  id                         String  @id @default(cuid())
  organizationId             String  @unique
  baseCurrency               String  @default("USD")
  fiscalYearStart            String  @default("January")
  bankBalance                Float   @default(0)
  averageMonthlyExpenses     Float?
  deferredRevenueRules       Json // ["annual", "yearly", "subscription"]
  deferralPeriodMonths       Int     @default(12)
  contractVerificationSource String  @default("manual")
  requireAuditSeal           Boolean @default(true)
  autoRejectUnverified       Boolean @default(false)
  targetMonthlyRevenue       Float   @default(10000)
  lowRunwayAlertThreshold    Int     @default(3)
  enableVoiceSummary         Boolean @default(true)
  elevenLabsVoiceId          String  @default("21m00Tcm4TlvDq8ikWAM")
  voiceScriptTemplate        String  @default("Karina, a {{amount}} credit has been reconciled under ASC 606. This improves our net income for the quarter and extends our cash runway by {{runwayDays}} days, moving our 'Zero Cash Date' to {{zeroCashDate}}. We are currently {{percentAhead}}% ahead of our financial plan.")
  enableSMS                  Boolean @default(false)
  smsRecipientNumber         String?
  twilioAccountSid           String?
  twilioAuthToken            String?
  twilioFromNumber           String?
  elevenLabsApiKey           String?
  aiModel                    String  @default("gpt-4o-mini") // Can be configurable by user (e.g. gpt-4, claude-3-haiku)
  aiApiKey                   String? // Optional user-provided API key for their preferred provider
  aiProvider                 String? @default("openai")
  embeddingProvider          String? @default("openai")
  embeddingModel             String? @default("text-embedding-3-small")
  expenseCategories          Json?   @default("[\"Software\", \"Hardware\", \"Office Supplies\", \"Travel\", \"Meals\", \"Legal\", \"Marketing\", \"Other\"]")
  anomalyThreshold           Float   @default(50000)

  // Email Settings
  emailProvider String? @default("smtp") // smtp, sendgrid, resend
  emailFrom     String? @default("billing@yourcompany.com")
  smtpHost      String?
  smtpPort      Int?
  smtpUser      String?
  smtpPass      String?

  // Stripe Integration
  stripeSecretKey     String?
  stripeWebhookSecret String?

  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String
  issueDate        DateTime      @default(now())
  dueDate          DateTime
  clientName       String
  clientEmail      String
  clientAddress    Json?
  subtotal         Float
  totalTax         Float
  total            Float
  currency         String        @default("USD")
  fxRate           Float?
  totalFunctional  Float?
  status           InvoiceStatus @default(DRAFT)
  pdfUrl           String?
  organizationId   String
  customerId       String?
  salesOrderId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  lineItems    InvoiceLineItem[]
  payments     Payment[]
  creditNotes  CreditNote[]
  transactions Transaction[]
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  customer     Customer?         @relation(fields: [customerId], references: [id])
  organization Organization      @relation(fields: [organizationId], references: [id])

  @@index([customerId])
  @@index([salesOrderId])
}

model InvoiceLineItem {
  id          String   @id @default(cuid())
  productId   String?
  description String
  quantity    Float
  unitPrice   Float
  discount    Float    @default(0)
  taxRate     Float    @default(0)
  amount      Float
  accountCode String?
  notes       String?
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  product     Product? @relation("InvoiceLineProduct", fields: [productId], references: [id])
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PARTIAL
  PAID
  VOID
  REFUNDED
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  amount          Float
  paymentDate     DateTime
  method          String   @default("bank_transfer")
  referenceNumber String?
  notes           String?
  transactionId   String?
  createdById     String?
  organizationId  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  invoice          Invoice           @relation(fields: [invoiceId], references: [id])
  transaction      Transaction?      @relation("PaymentTransaction", fields: [transactionId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  bankTransactions BankTransaction[] @relation("BankTransactionPayment")

  @@index([invoiceId])
  @@index([organizationId, paymentDate])
}

model CreditNote {
  id              String    @id @default(cuid())
  invoiceId       String
  amount          Float
  reason          String
  reasonCategory  String    @default("other")
  refundType      String    @default("credit_memo") // credit_memo | cash_refund | stripe_refund
  issueDate       DateTime  @default(now())
  refundMethod    String?
  refundDate      DateTime?
  referenceNumber String?
  notes           String?
  transactionId   String?
  createdById     String?
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoice      Invoice      @relation(fields: [invoiceId], references: [id])
  transaction  Transaction? @relation("CreditNoteTransaction", fields: [transactionId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([invoiceId])
  @@index([organizationId, issueDate])
}

model VendorDebitMemo {
  id              String    @id @default(cuid())
  memoNumber      String
  vendorId        String
  vendorInvoiceId String?
  amount          Float
  reason          String
  reasonCategory  String    @default("other") // overcharge | defective_goods | service_not_rendered | duplicate_payment | other
  debitType       String    @default("vendor_credit") // vendor_credit | cash_refund
  status          String    @default("OPEN") // OPEN | APPLIED | PAID | VOID
  issueDate       DateTime  @default(now())
  referenceNumber String?
  notes           String?
  createdById     String?
  organizationId  String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor        Vendor         @relation(fields: [vendorId], references: [id])
  vendorInvoice VendorInvoice? @relation(fields: [vendorInvoiceId], references: [id])
  organization  Organization   @relation(fields: [organizationId], references: [id])

  @@index([vendorId])
  @@index([organizationId, issueDate])
  @@index([organizationId, status])
}

model Expense {
  id                String        @id @default(cuid())
  expenseNumber     String?
  date              DateTime
  description       String
  amount            Float
  currency          String        @default("USD")
  fxRate            Float?
  amountFunctional  Float?
  category          String?
  taxRelevant       Boolean?
  status            ExpenseStatus @default(PENDING)
  approvedBy        String?
  approvedAt        DateTime?
  approvalRequestId String?
  organizationId    String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  organization     Organization      @relation(fields: [organizationId], references: [id])
  anomalies        ExpenseAnomaly[]
  vendorPayments   VendorPayment[]   @relation("VendorPaymentExpense")
  approvalRequest  ApprovalRequest?  @relation(fields: [approvalRequestId], references: [id])
}

model ExpenseAnomaly {
  id              String        @id @default(cuid())
  type            AnomalyType
  description     String
  confidence      Float         @default(1.0)
  isFalsePositive Boolean       @default(false)
  status          AnomalyStatus @default(PENDING)
  expenseId       String
  organizationId  String
  createdAt       DateTime      @default(now())

  expense      Expense      @relation(fields: [expenseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

enum AnomalyType {
  DUPLICATE
  UNUSUAL_AMOUNT
  WEEKEND_EXPENSE
  UNUSUAL_CATEGORY
}

enum AnomalyStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum ExpenseStatus {
  PENDING
  CATEGORIZED
  REVIEWED
  APPROVED
  PAID
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  password          String?
  name              String
  status            UserStatus @default(ACTIVE)
  isSuperAdmin      Boolean    @default(false)
  resetToken        String?    @unique
  resetTokenExpiry  DateTime?
  reportPreferences Json? // { receiveWeekly: boolean, reportTypes: string[] }
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  organizations    UserOrganization[]
  chatMessages     ChatMessage[]
  dashboardLayouts DashboardLayout[]
}

model UserOrganization {
  userId         String
  organizationId String
  roleId         String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
}

model Role {
  id             String             @id @default(cuid())
  name           String
  description    String?
  isSystem       Boolean            @default(false)
  organizationId String?
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  permissions    RolePermission[]
  userOrgs       UserOrganization[]
}

model Permission {
  id          String           @id @default(cuid())
  name        String           @unique // e.g. "users:manage"
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

model TaxRule {
  id             String       @id @default(cuid())
  name           String
  jurisdiction   String // Country ISO or US State ISO
  rate           Float
  taxType        TaxType      @default(VAT)
  isNexus        Boolean      @default(false)
  appliesTo      String[] // product categories
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

enum TaxType {
  VAT
  SALES_TAX
  GST
}

model Webhook {
  id             String    @id @default(cuid())
  url            String
  events         String[] // ["invoice.paid", "expense.created"]
  secret         String
  lastSent       DateTime?
  failures       Int       @default(0)
  organizationId String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  logs         WebhookLog[]
}

model WebhookLog {
  id           String   @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  success      Boolean
  retryCount   Int      @default(0)
  createdAt    DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id])
}

model ReportSchedule {
  id             String     @id @default(cuid())
  organizationId String
  type           ReportType
  frequency      Frequency
  recipients     String[] // Emails
  lastSent       DateTime?
  nextRun        DateTime?
  createdAt      DateTime   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Notification {
  id             String   @id @default(cuid())
  type           String // "INFO", "SUCCESS", "WARNING", "ERROR"
  title          String
  message        String
  link           String? // Optional URL to redirect to
  read           Boolean  @default(false)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
}

enum ReportType {
  CASH_FLOW
  TAX_SUMMARY
  FULL_DIGEST
}

enum Frequency {
  WEEKLY
  MONTHLY
}

enum Plan {
  FREE
  PRO
  SCALE
}

enum OrgStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

model SubscriptionPlan {
  id            String   @id @default(cuid())
  name          String   @unique
  description   String?
  price         Float
  interval      String   @default("month")
  features      Json
  isActive      Boolean  @default(true)
  stripePriceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  licenses License[]
}

model License {
  id             String           @id @default(cuid())
  organizationId String           @unique
  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  maxUsers       Int              @default(5)
  maxApiCalls    Int              @default(10000)
  maxAiTokens    Int              @default(50000)
  startsAt       DateTime         @default(now())
  endsAt         DateTime?
  status         LicenseStatus    @default(ACTIVE)
  organization   Organization     @relation(fields: [organizationId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model UsageMetrics {
  id             String       @id @default(cuid())
  organizationId String
  date           DateTime     @default(now())
  apiCalls       Int          @default(0)
  aiTokensUsed   Int          @default(0)
  storageBytes   Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, date])
  @@index([organizationId, date])
}

model Transaction {
  id                    String  @id @default(cuid())
  transactionNumber     String?
  direction             String  @default("inbound") // inbound | outbound
  transactionType       String  @default("StripePayment") // StripePayment | VendorPayment
  stripePaymentIntentId String? @unique
  amount                Float
  currency              String  @default("usd")
  description           String?
  customerEmail         String?

  // Payment and clearing fields
  stripeChargeId  String? // charge_xxx, needed to fetch fee details
  stripeFee       Float?    @default(0) // 2.9% + $0.30 in dollars
  stripeNet       Float? // amount - stripeFee
  fxFee           Float?    @default(0) // additional 1% FX fee if international
  payoutId        String? // payout_xxx from Stripe payout.paid event
  payoutDate      DateTime? // date funds actually land in bank
  clearingStatus  String    @default("pending") // pending | paid_out
  paymentMethod   String? // stripe | bank_transfer | ach | etc.
  paymentFraction Float?    @default(1) // for partial payments

  // Invoice linkage (O2C)
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])

  // P2P linkage
  vendorPaymentId String?       @unique
  vendorPayment   VendorPayment? @relation("TransactionVendorPayment", fields: [vendorPaymentId], references: [id])
  vendorName      String? // denormalized for display

  // R2R & O&M fields
  revenueRecognitionType String @default("immediate") // immediate, deferred
  recognizedRevenue      Float? // amount recognized now
  deferredRevenue        Float? @default(0)

  // Auditor fields
  auditStatus String  @default("pending") // pending, verified, failed
  auditHash   String?

  // FP&A fields
  runwayMonths Float?
  zeroCashDate DateTime?
  percentAhead Float? // % ahead of financial plan

  // Workflow state
  agentStatus    Json? // stores logs per agent: { r2r: "done", om: "pending", ... }
  agentLogs      Json? // array of { agent, message, timestamp }
  workflowStatus String @default("pending") // pending, running, completed, error

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  payments          Payment[]                  @relation("PaymentTransaction")
  creditNotes       CreditNote[]               @relation("CreditNoteTransaction")
  deferredSchedules DeferredRevenueSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contract {
  id             String    @id @default(cuid())
  contractNumber String?
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  customerEmail  String
  amount         Float
  status         String    @default("signed") // signed, pending, expired
  description    String?
  terms          String?
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime  @default(now())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model DeferredRevenueSchedule {
  id             String    @id @default(cuid())
  transactionId  String
  period         DateTime // first day of recognition month
  amount         Float // amount to recognize in this period
  recognized     Boolean   @default(false)
  recognizedAt   DateTime?
  glEntryId      String? // FK to GeneralLedgerEntry once booked
  organizationId String
  createdAt      DateTime  @default(now())

  transaction Transaction         @relation(fields: [transactionId], references: [id])
  glEntry     GeneralLedgerEntry? @relation(fields: [glEntryId], references: [id])

  @@index([organizationId, period])
  @@index([transactionId])
}

model FinancialSnapshot {
  id                     String       @id @default(cuid())
  bankBalance            Float
  averageMonthlyExpenses Float
  runwayMonths           Float
  zeroCashDate           DateTime
  updatedAt              DateTime     @updatedAt
  organizationId         String       @unique
  organization           Organization @relation(fields: [organizationId], references: [id])
}

model DashboardLayout {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  widgets        Json
  updatedAt      DateTime @updatedAt

